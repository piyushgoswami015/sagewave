# ── Auth (Google OAuth) ─────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Stem separation (Demucs on Replicate) ───────────────────────────
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional overrides
REPLICATE_DEMUCS_MODEL=ryan5453/demucs
DEMUCS_VARIANT=htdemucs_ft

# ── Downloader (optional) ───────────────────────────────────────────
# Path to yt-dlp / ffmpeg if not on PATH
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Some reels need a logged-in session. Use cookies from a local browser
# (e.g. chrome, safari, firefox) OR a cookies.txt file.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
